{
    "benchmark": {
        "name": "local_llm_benchmark",
        "use_case": "chat",
        "test_id": "CHAT-002"
    },

    "model": {
        "name": "qwen3:4b",
        "family": "Qwen",
        "parameters_b": 4,
        "quantization": "unknown",
        "runtime": "ollama"
    },

    "docker": {
        "image": "ollama/ollama:latest",
        "container_name_prefix": "benchmark",
        "port": 11434,
        "volume": "ollama_models"
    },

    "inference": {
        "prompt": "Write 2000 words essay about Netherlands history.",
        "timeout_seconds": 3600
    },

    "monitoring": {
        "samples": 10,
        "interval_seconds": 15
    },

    "database": {
        "path": "database/benchmark.db"
    }
}